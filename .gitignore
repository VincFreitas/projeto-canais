.venv/
.env
obra/
dados/cache/
assets/vozes/*.onnx
assets/vozes/*.onnx.json
__pycache__/
*.pyc
tmp/

# credenciais (nunca versionar)
credenciais/
*client_secret*.json
token*.json

# repo público: sem vídeos gerados nem transcrições de terceiros
saida/**/*.mp4
pesquisa/*/*/transcricoes/

# músicas baixadas ficam só no PC (licenças variam); só a lista de liberadas vai para o Git
assets/musica/**/*.mp3
assets/musica/**/*.wav
assets/musica/**/*.m4a
assets/musica/**/*.ogg

# Estúdio: tarefas e testes de conexão são locais
perfis/*/controle/jobs/
perfis/*/controle/conexoes.json

# workflow do n8n gerado para a pasta deste PC (o modelo é que vai para o Git)
n8n/workflow.json

# modelos locais de IA (pesados)
modelos/

# Estúdio: arquivos enviados no editor de cenas, medições de referências e buscas de assuntos ficam no PC
perfis/*/fila/midia/
perfis/*/controle/referencias.json
perfis/*/controle/descobrir.json
perfis/*/controle/conferencias/
roteiros/midia/

# identidade visual: fundo bruto (pesado, refeito pelo gerador) e pacote de envio
perfis/*/marca/fundo-capa.png
perfis/*/marca/pacote.json
perfis/*/controle/leva.trava
perfis/*/controle/leva-pendentes.json
perfis/*/controle/leva-ultima.log
perfis/*/controle/estatisticas.json
perfis/*/controle/estatisticas-historico.jsonl
perfis/*/controle/sugestoes.json

# aplicação no PC: preferências, nota da última atualização, sinal de reinício e registro
dados/app.json
dados/ultima_atualizacao.json
dados/reiniciar
dados/estudio.log
dados/n8n-ligando
dados/bloqueio-google.json

# bibliotecas do palco 3D (npm install em web/)
web/node_modules/
perfis/*/controle/nuvem.trava
perfis/*/controle/nuvem.de-novo

# WhatsApp: estado da conversa, entregas do webhook e o túnel baixado
dados/whatsapp/
dados/apps/
dados/bin/
n8n/whatsapp.json
dados/amostras-voz/
# gravação da voz do dono para a clonagem: dado pessoal, nunca vai para o Git
dados/minha-voz/
# carrosséis do Instagram: imagens geradas e estado de cada um
saida/*-carrossel/
perfis/*/controle/carrosseis/

# estado de execução de cada canal (muda a todo minuto; fica só no PC)
perfis/*/controle/estado.json
perfis/*/controle/slots.json
perfis/*/controle/falhas.log
perfis/*/controle/levas.log
perfis/*/controle/youtube_canal.json
perfis/*/controle/comentarios.json
perfis/*/controle/leva-adiada.json
perfis/*/controle/leva-limite.json
perfis/*/controle/descricoes/
perfis/*/publicados/
/controle/
saida/*-musica.json
saida/*-metadados.md
!saida/exemplo-*-metadados.md
saida/amostras-voz/
saida/vozes-teste/

# canais criados no Estúdio e o conteúdo de cada um ficam só no PC (o repositório fala só da aplicação)
perfis/*/
cenas/*
!cenas/comum3d.js
roteiros/*
!roteiros/exemplo-*.json
