.venv/
.env
obra/
dados/cache/
assets/vozes/*.onnx
assets/vozes/*.onnx.json
__pycache__/
*.pyc
tmp/

# credenciais (nunca versionar)
credenciais/
*client_secret*.json
token*.json

# repo público: sem vídeos gerados nem transcrições de terceiros
saida/*.mp4
pesquisa/*/*/transcricoes/

# músicas baixadas ficam só no PC (licenças variam); só a lista de liberadas vai para o Git
assets/musica/**/*.mp3
assets/musica/**/*.wav
assets/musica/**/*.m4a
assets/musica/**/*.ogg

# Estúdio: tarefas e testes de conexão são locais
perfis/*/controle/jobs/
perfis/*/controle/conexoes.json
perfis/*/controle/pulga-avatar.png

# workflow do n8n gerado para a pasta deste PC (o modelo é que vai para o Git)
n8n/workflow.json

# modelos locais de IA (pesados)
modelos/

# Estúdio: arquivos enviados no editor de cenas, medições de referências e buscas de assuntos ficam no PC
perfis/*/fila/midia/
perfis/*/controle/referencias.json
perfis/*/controle/descobrir.json
perfis/*/controle/pulga-avatar-pixel.png
perfis/*/controle/conferencias/
roteiros/midia/

# identidade visual: fundo bruto (pesado, refeito pelo gerador) e pacote de envio
perfis/*/marca/fundo-capa.png
perfis/*/marca/pacote.json
perfis/*/controle/leva.trava
perfis/*/controle/leva-pendentes.json
perfis/*/controle/leva-ultima.log
perfis/*/controle/estatisticas.json
perfis/*/controle/estatisticas-historico.jsonl
perfis/*/controle/sugestoes.json

# aplicação no PC: preferências, nota da última atualização, sinal de reinício, registro e ícone gerado
dados/app.json
dados/ultima_atualizacao.json
dados/reiniciar
dados/estudio.log
assets/icone.ico
