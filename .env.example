# Copie para .env e preencha só o que for usar. Nunca compartilhe o .env.

# Imagens e clipes gratuitos: https://www.pexels.com/api/ (grátis, libera na hora)
PEXELS_API_KEY=

# Alternativa ao Pexels (o Pexels pausou chaves novas em 2026-10): https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Motor de voz padrão: auto (edge e, se falhar, piper), edge, piper, elevenlabs, azure
MOTOR_VOZ=auto

# Azure Speech (oficial, mesmas vozes do edge, 500 mil caracteres/mês grátis)
# Portal Azure > Criar recurso "Speech" > Chaves e Ponto de Extremidade
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# ElevenLabs (pago, melhor qualidade): https://elevenlabs.io > Profile > API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ=
ELEVENLABS_MODELO=eleven_multilingual_v2
